APP_ENV=development
APP_ROLE=local
APP_REVISION=development

POSTGRES_DB=museum_image_db
POSTGRES_USER=museum
POSTGRES_PASSWORD=museum123
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://museum:museum123@postgres:5432/museum_image_db
EXHIBITION_POSTGRES_DB=museum_exhibition_db
EXHIBITION_POSTGRES_PORT=5433
EXHIBITION_DATABASE_URL=postgresql+psycopg://museum:museum123@exhibitions-postgres:5432/museum_exhibition_db

CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
BACKEND_PORT=8000

IMPORT_DIR=./import
# Use the production domain/proxy; the raw :8000 IP does not expose the cloud API routes.
CLOUD_API_BASE_URL=https://image.aituring.xyz
INGEST_TOKEN=
CLOUD_INGEST_CONCURRENCY=1
# Images above 4 MB use 3 MB raw chunks so they can pass the Vercel proxy safely.
CLOUD_INGEST_CHUNK_THRESHOLD_BYTES=4000000
CLOUD_INGEST_CHUNK_SIZE_BYTES=3000000
CLOUD_INGEST_CHUNK_TTL_SECONDS=21600

QWEN_WEB_ENABLED=false
QWEN_WEB_STORAGE_STATE=/data/qwen_web_state.json
WEB_BRIDGE_REMOTE_URL=
INSTALL_BROWSER=true

DASHSCOPE_API_KEY=
WEB_STRUCTURING_MODEL=qwen-plus

GOOGLE_PHOTOS_CLIENT_ID=
GOOGLE_PHOTOS_CLIENT_SECRET=
GOOGLE_PHOTOS_REDIRECT_URI=

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET=
OSS_PUBLIC_BASE_URL=

# 全球展览目录：云端 GitHub Actions 每天启动一次受限的临时 Worker；
# 需要连续历史回填时，再通过 exhibition-sync profile 显式启动常驻 Worker。
EXHIBITION_SYNC_ENABLED=true
EXHIBITION_SYNC_HOUR=3
EXHIBITION_SYNC_MINUTE=20
EXHIBITION_SYNC_TIMEZONE=Asia/Shanghai
EXHIBITION_SYNC_BACKFILL_BATCH_SIZE=200
EXHIBITION_SYNC_BACKFILL_PAUSE_SECONDS=60
EXHIBITION_SYNC_COMMIT_BATCH_SIZE=25
EXHIBITION_SYNC_COMMIT_PAUSE_SECONDS=1
EXHIBITION_SYNC_CONCURRENCY=1
EXHIBITION_SYNC_CPU_LIMIT=0.20

# 仅云端部署需要
BACKEND_IMAGE=
