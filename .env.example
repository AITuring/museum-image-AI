APP_ENV=development
POSTGRES_DB=museum_image_db
POSTGRES_USER=museum
POSTGRES_PASSWORD=museum123
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://museum:museum123@postgres:5432/museum_image_db
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
DASHSCOPE_API_KEY=
QWEN_VISION_MODEL=qwen3-vl-plus
VOLCENGINE_API_KEY=
DOUBAO_VISION_MODEL=
# Web search augmentation backend: none | duckduckgo | bing
VISION_SEARCH_BACKEND=duckduckgo
# Required only when VISION_SEARCH_BACKEND=bing
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
# Reverse image search ("相似图检索") backend: none | google_vision
# Matches the real image against indexed artifact photos, mirroring Qwen 网页端的相似图检索。
# Leave GOOGLE_VISION_API_KEY empty to disable; pipeline falls back to text search only.
VISION_REVERSE_IMAGE_BACKEND=google_vision
GOOGLE_VISION_API_KEY=
GOOGLE_VISION_ENDPOINT=https://vision.googleapis.com/v1/images:annotate

# Browser bridge to 通义网页端 (qianwen.com), which has built-in 相似图检索.
# It must drive a *real* Google Chrome (consumer sites gate uploads against bundled
# headless Chromium), running headful (behind Xvfb in Docker). Steps:
#   1) run scripts/web_bridge_login.py once to log in; it saves the session to
#      data/qwen_web_state.json (mount/copy this to QWEN_WEB_STORAGE_STATE)
#   2) set QWEN_WEB_ENABLED=true
# NB: 豆包 is not supported — its upload entry does not respond to automation even under
# real Chrome with a logged-in session.
# Shared:
WEB_HEADLESS=false
WEB_BROWSER_CHANNEL=chrome
WEB_USER_DATA_DIR=/data/web_chrome_profile
WEB_TIMEOUT_SECONDS=150
WEB_UPLOAD_MAX_FILE_BYTES=10485760
WEB_UPLOAD_TARGET_MIN_FILE_BYTES=2097152
WEB_UPLOAD_TARGET_MAX_FILE_BYTES=8388608
WEB_UPLOAD_MAX_DIMENSION=4096
WEB_BRIDGE_REMOTE_URL=
WEB_BRIDGE_REMOTE_TIMEOUT_SECONDS=240
WEB_BRIDGE_REMOTE_START_COMMAND=.venv-webtune/bin/python backend/scripts/host_web_bridge_server.py --port 8011
WEB_STRUCTURING_MODEL=qwen-plus
# 通义 (qianwen.com)
QWEN_WEB_ENABLED=false
QWEN_WEB_URL=https://www.qianwen.com/
QWEN_WEB_STORAGE_STATE=/data/qwen_web_state.json
# CSS selector for the rendered answer; tune against the live DOM if extraction fails.
QWEN_WEB_ANSWER_SELECTOR=[class*='markdown']
# Accessible name of the attach/upload button (fallback if the file input is lazy).
QWEN_WEB_ATTACH_NAME=添加附件
# Google Photos import (local side only). Redirect URI should point to:
#   http://localhost:8000/api/google-photos/callback
# or your local backend public URL + /api/google-photos/callback
GOOGLE_PHOTOS_CLIENT_ID=
GOOGLE_PHOTOS_CLIENT_SECRET=
GOOGLE_PHOTOS_REDIRECT_URI=
GOOGLE_PHOTOS_TOKEN_PATH=/data/google_photos_token.json
# Downscale local images before sending to the model (longest side in px, 0 disables)
VISION_MAX_IMAGE_DIMENSION=1280
VISION_IMAGE_JPEG_QUALITY=85

# ── Batch identify (LOCAL) → cloud ingest (ALIBABA CLOUD) topology ─────────────────
# Role of THIS deployment: "local" (scan + qwen bridge + stage + push) or
# "cloud" (receive submissions, store images in OSS, serve query/search).
# Local: use docker-compose.yml.  Cloud: use docker-compose.cloud.yml (sets this to cloud).
APP_ROLE=local

# Host port the cloud backend is published on (docker-compose.cloud.yml).
BACKEND_PORT=8000
# For Vercel option B (frontend connects directly): add your Vercel domain(s) here,
# comma-separated, so CORS allows the browser. Option A (Vercel rewrites) needs nothing.
# e.g. CORS_ORIGINS=https://your-app.vercel.app

# Directory of local images to import (bind-mounted to /data/import). Scan /data/import
# in the UI. Only used by docker-compose on the local machine.
IMPORT_DIR=./import

# --- LOCAL side: where to push reviewed records, and the shared secret ---
# Base URL of the cloud API (the Alibaba Cloud server running this app in cloud role).
CLOUD_API_BASE_URL=
# Shared bearer token. The local side sends it; the cloud side validates it. Keep equal.
INGEST_TOKEN=

# --- CLOUD side: Alibaba Cloud OSS for image storage ---
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# e.g. https://oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=
OSS_BUCKET=
OSS_KEY_PREFIX=artifacts/
# Optional: custom domain / CDN base URL for stored objects. Empty = derive from bucket.
OSS_PUBLIC_BASE_URL=
