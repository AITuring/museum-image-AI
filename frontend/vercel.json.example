{
  "$comment": "Option A (recommended): copy to vercel.json and replace YOUR_BACKEND_HOST with your Alibaba server (e.g. http://1.2.3.4:8000). Vercel proxies /api & /files server-side, so the browser stays same-origin: no CORS and no backend HTTPS needed. With this file, set the frontend env VITE_API_BASE_URL='' (empty) and VITE_CLOUD_ONLY=true.",
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://YOUR_BACKEND_HOST/api/:path*" },
    { "source": "/files/:path*", "destination": "http://YOUR_BACKEND_HOST/files/:path*" }
  ]
}
